# Docker 環境變數配置範例
# 複製此文件為 .env 並修改相應的值

# ==================== 資料庫配置 ====================
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# ==================== API 服務配置 ====================
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=false
API_WORKERS=4

# ==================== Adminer 配置（可選） ====================
# 取消註釋以啟用 Adminer 資料庫管理工具
# ADMINER_PORT=8080

# ==================== 應用配置 ====================
# 排程器開關
SCHEDULER_ENABLED=true

# 每日資料獲取時間（24小時制，格式：HH:MM）
SCHEDULER_DAILY_FETCH_TIME=18:00

# 日誌級別（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# Yahoo Finance 資料獲取間隔（秒）
YAHOO_FETCH_INTERVAL=300
