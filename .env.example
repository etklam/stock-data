# 數據庫配置（敏感信息 - 從環境變數讀取）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stocks_data
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here

# API 服務器配置
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# 以下配置可在 config.yaml 中設置默認值，這裡可以覆蓋它們

# Yahoo Finance 配置
# YAHOO_FETCH_INTERVAL=300
# YAHOO_START_DATE=2020-01-01

# 調度器配置
# SCHEDULER_ENABLED=true
# DAILY_FETCH_TIME=18:00
# MAX_RETRIES=3
# RETRY_INTERVAL=60

# 日誌配置
# LOG_LEVEL=INFO
# LOG_FILE=logs/stocks_data.log
# LOG_MAX_SIZE=10485760
# LOG_BACKUP_COUNT=5

# 應用配置
# APP_DEBUG=false
# APP_NAME=Stock Data System
# APP_VERSION=1.0.0